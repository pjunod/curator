#!/bin/sh
# Fast checks on every commit. Full tests run on pre-push and in CI.
#
# If a toolchain is missing locally, that check is SKIPPED with a warning —
# CI is the enforcing gate, hooks are the fast local courtesy.
# Install once with: make hooks
set -e

staged() {
    git diff --cached --name-only --diff-filter=ACMR
}

go_files=$(staged | grep '\.go$' | grep -v '/gen/' || true)
if [ -n "$go_files" ]; then
    if command -v go >/dev/null 2>&1; then
        unformatted=$(gofmt -l $go_files)
        if [ -n "$unformatted" ]; then
            echo "pre-commit: gofmt needed on:" >&2
            echo "$unformatted" >&2
            echo "run: make fmt" >&2
            exit 1
        fi
        echo "pre-commit: go vet"
        go vet ./...
    else
        echo "pre-commit: WARNING — go not installed; skipping gofmt/vet (CI will check)" >&2
    fi
fi

if staged | grep -q '^web/src/'; then
    if command -v npm >/dev/null 2>&1 && [ -d web/node_modules ]; then
        echo "pre-commit: web typecheck"
        npm --prefix web run -s typecheck
    else
        echo "pre-commit: WARNING — npm or web/node_modules missing; skipping typecheck (CI will check)" >&2
    fi
fi

if staged | grep -Eq '^(internal/infra/sqlite/(migrations|queries)/|internal/api/openapi\.yaml)'; then
    echo "pre-commit: SQL or API spec changed — remember 'make gen' (CI enforces it)" >&2
fi
