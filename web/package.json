{
  "name": "monarr-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:dependency-patches && vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:dependency-patches": "node --test vendor/deepmerge/regressions.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-router": "^1.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0",
    "deepmerge": "file:vendor/deepmerge"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.4"
    },
    "@rollup/plugin-node-resolve": {
      "deepmerge": "$deepmerge"
    }
  }
}
