# binaries & runtime state
/bin/
/data/
*.db
*.db-wal
*.db-shm

# web
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# tooling noise. coverage.svg is deliberately NOT listed: it is tracked on
# main so the README can point at it with a relative path, which is the only
# form that renders while the repo is private (README → Coverage).
coverage.out
coverage.html
*.log
.DS_Store

# e2e
test/e2e/node_modules/
test/e2e/test-results/
test/e2e/playwright-report/

# deploy/: your customized compose + local data stay untracked; the
# .example file is the tracked template
deploy/docker-compose.yml
deploy/docker-compose.yaml
deploy/compose.yml
deploy/compose.yaml
deploy/monarr-data/
deploy/pool/
deploy/qbittorrent-config/
deploy/.env

# Playwright artifacts
test/e2e/test-results/
test-results/
