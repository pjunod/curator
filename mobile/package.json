{
  "name": "monarr-mobile",
  "version": "0.29.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:device": "expo run:ios --configuration Release --device",
    "export": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~58.1.0",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-network": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.2",
    "@types/react-test-renderer": "^19.3.1",
    "expo-doctor": "1.20.1",
    "react-test-renderer": "19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@expo/fingerprint": {
      "minimatch": "^11.0.5"
    }
  }
}
