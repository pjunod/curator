{
  "name": "monarr-mobile",
  "version": "0.29.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:device": "expo run:ios --configuration Release --device",
    "export": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~57.0.33",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-network": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "expo-doctor": "1.20.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@expo/fingerprint": {
      "minimatch": "^11.0.5"
    }
  }
}
