# Monarr compose environment — cp .env.example .env and edit to OVERRIDE.
# Every value shown here is already the compose file's built-in default,
# so a .env is only needed where your setup differs. Your .env is
# gitignored; pulls only ever update this example.
#
# After editing, run ./bootstrap.sh — it reads this file and creates every
# directory below owned by PUID:PGID. Skipping it is how you get a
# root-owned bind mount that Monarr cannot write to.

# Config: SQLite database, daily backups, runtime state. Back this up.
# Must have local-disk semantics — never NFS/Gluster (docs/deployment.md).
#MONARR_DATA=/srv/monarr

# The pool: media library AND the download client's completed folder,
# under one mount (enables hardlink imports). Shared storage is fine here.
# Layout: $MONARR_POOL/media/{movies,tv,books} + $MONARR_POOL/downloads
#MONARR_POOL=/srv/pool

# User/group the container runs as — must own MONARR_DATA (or Monarr can't
# create its database) and should own the pool (or imports land root-owned).
# `id -u` / `id -g` on the host. Change these and re-run ./bootstrap.sh.
#PUID=1000
#PGID=1000

# Only used by the optional bundled qbittorrent service (commented out in
# the compose template).
#QBIT_CONFIG=/srv/qbittorrent
